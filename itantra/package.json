{
  "name": "itantra",
  "version": "0.1.0",
  "private": true,
  "description": "iTantra (SIH26173): offline device-to-device voice link for Indian languages",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r --filter @itantra/protocol-ts --filter @itantra/bridge build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "vectors": "pnpm --filter @itantra/protocol-ts exec tsx src/cli/generateVectors.ts",
    "bench:size": "python3 tools/bench/bench.py size"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
